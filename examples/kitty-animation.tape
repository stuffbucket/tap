Set Shell "/bin/sh"
Set Width 960
Set Height 540
Set FontSize 16
Set Framerate 120
Set TypingSpeed 1ms
Hide
Type "printf '\033_Ga=T,f=32,i=2,s=1,v=1,c=24,r=10,q=2;/wAA/w==\033\\\033_Ga=f,f=32,i=2,s=1,v=1,z=40,q=2;AAD//w==\033\\\033_Ga=a,i=2,r=1,z=30,q=2\033\\\033_Ga=a,i=2,s=3,q=2\033\\'"
Enter
Sleep 50ms
Show
Sleep 1s
Screenshot "kitty-animation.png"
Output "kitty-animation.mp4"
